{
  "name": "supportflow-ai",
  "version": "1.3.0",
  "description": "API de triagem de chamados criada para praticar TypeScript, suporte técnico, automação, SQLite e documentação OpenAPI.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "typescript",
    "fastify",
    "sqlite",
    "openapi",
    "swagger",
    "support",
    "helpdesk",
    "automation",
    "ai",
    "api"
  ],
  "license": "MIT"
}
