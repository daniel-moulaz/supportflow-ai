{
  "name": "supportflow-ai",
  "version": "1.2.0",
  "description": "API de triagem de chamados criada para praticar TypeScript, suporte técnico, automação e persistência com SQLite.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "typescript",
    "fastify",
    "sqlite",
    "support",
    "helpdesk",
    "automation",
    "ai",
    "api"
  ],
  "license": "MIT"
}
